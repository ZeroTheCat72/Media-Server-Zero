function File({format, file}) {
	if (format == 'file explorer') {
		return (
			<div className={file.isDir ? 'folder' : 'file'}>
			<h3>{file.isDir ? `📁 ${file.name}` : `📄 ${file.name}`}</h3>
			</div>)
	} else if (format == 'picture') {
		if (!file.isDir) return (
			<div className='pictureTile'>
			{/.mp4$/.test(file.name) ? <video controls src={`http://localhost:3001/pictures/${file.name}`} /> :  <img src={`http://localhost:3001/pictures/${file.name}`} />}
			</div>
		)
	} else if (format == 'movie'){
		return (
			<div className='movieTile'>
			<img src={`http://localhost:3001/movies/artwork/${file.name}`} />
			</div>
		)
	}
}

function toggleExplorer(whatSire = true) {
  const root = document.getElementById('root');
  const tab = document.getElementById('fileExplorerTab');

  if (whatSire) {
  	root.style.display = 'none';
  	tab.style.display = 'block';
  } else {
	  root.style.display = 'block'
	  tab.style.display = 'none'
  }

}

async function fetchFiles(dir, includeFolders=true) {
	const response = await fetch(`http://localhost:3001/fileExplorer/${dir}`)
	let resJSed = await response.json()
	if (!includeFolders) return resJSed.filter((file) => !file.isDir)
	return resJSed
}

